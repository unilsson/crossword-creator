# Kopiera till .env och fyll i. .env checkas aldrig in i git.

# Port på din dator
PORT=8083

# 1 = hämta SALDO automatiskt vid första start
AUTO_FETCH_SALDO=1

# AI för ledtrådsförslag: none | anthropic | openai
AI_PROVIDER=none

# Claude (Anthropic)
#AI_PROVIDER=anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#AI_MODEL=claude-haiku-5-5

# OpenAI eller annat OpenAI-kompatibelt API (Mistral, Ollama, LM Studio …)
#AI_PROVIDER=openai
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=<modellnamn hos leverantören>

# Exempel: lokal Ollama på samma dator
#AI_PROVIDER=openai
#OPENAI_API_KEY=
#OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#AI_MODEL=llama3.1
